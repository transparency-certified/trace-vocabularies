    <!-- https://w3id.org/trace/2023/05/trov#ArtifactArrangement -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#ArtifactArrangement">
        <rdfs:comment>A named collection of artifact locations capturing where artifacts were at a point in a workflow.</rdfs:comment>
        <rdfs:label>ArtifactArrangement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/2023/05/trov#ArtifactComposition -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#ArtifactComposition">
        <rdfs:comment>The set of all digital artifacts described by a TRO.</rdfs:comment>
        <rdfs:label>ArtifactComposition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/2023/05/trov#ArtifactLocus -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#ArtifactLocus">
        <rdfs:comment>The location of a specific artifact within an arrangement.</rdfs:comment>
        <rdfs:label>ArtifactLocus</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/2023/05/trov#CompositionFingerprint -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#CompositionFingerprint">
        <rdfs:comment>A hash computed over the sorted hashes of all artifacts in a composition.</rdfs:comment>
        <rdfs:label>CompositionFingerprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/2023/05/trov#ResearchArtifact -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#ResearchArtifact">
        <rdfs:comment>A digital object identified by a content hash.</rdfs:comment>
        <rdfs:label>ResearchArtifact</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/2023/05/trov#TRPAttribute -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#TRPAttribute">
        <rdfs:comment>A transparency attribute of a TRP, warranted by a TRS capability.</rdfs:comment>
        <rdfs:label>TRPAttribute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/2023/05/trov#TRSCapability -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#TRSCapability">
        <rdfs:comment>A capability of a TRS.</rdfs:comment>
        <rdfs:label>TRSCapability</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/2023/05/trov#TransparentResearchObject -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#TransparentResearchObject">
        <rdfs:comment>A set of research artifacts produced by one or more TRPs and signed by the assembling TRS.</rdfs:comment>
        <rdfs:label>TransparentResearchObject</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/2023/05/trov#TrustedResearchPerformance -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#TrustedResearchPerformance">
        <rdfs:comment>A supervised unit of work conducted by a TRS.</rdfs:comment>
        <rdfs:label>TrustedResearchPerformance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/2023/05/trov#TrustedResearchSystem -->


    <owl:Class rdf:about="https://w3id.org/trace/2023/05/trov#TrustedResearchSystem">
        <rdfs:comment>A system that performs TRPs and assembles TROs.</rdfs:comment>
        <rdfs:label>TrustedResearchSystem</rdfs:label>
    </owl:Class>
    


