  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/trace/2023/05/trov#TRPAttribute"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "All network accesses during the TRP were recorded."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "InternetAccessRecording"
