#################################################################
#    Classes
#################################################################

###  https://w3id.org/trace/trov/0.1#ArtifactArrangement
<https://w3id.org/trace/trov/0.1#ArtifactArrangement> rdf:type owl:Class ;
                                                      rdfs:comment "A named collection of artifact locations. Arrangements are linked to performances as inputs or outputs." ;
                                                      rdfs:label "ArtifactArrangement" .


###  https://w3id.org/trace/trov/0.1#ArtifactCollection
<https://w3id.org/trace/trov/0.1#ArtifactCollection> rdf:type owl:Class ;
                                                     rdfs:comment "Base class for collections of one or more artifacts." ;
                                                     rdfs:label "ArtifactCollection" .


###  https://w3id.org/trace/trov/0.1#ArtifactComposition
<https://w3id.org/trace/trov/0.1#ArtifactComposition> rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://w3id.org/trace/trov/0.1#ArtifactCollection> ;
                                                      rdfs:comment "The set of all digital artifacts described by a TRO, identified by a composition fingerprint." ;
                                                      rdfs:label "ArtifactComposition" .


###  https://w3id.org/trace/trov/0.1#ArtifactLocation
<https://w3id.org/trace/trov/0.1#ArtifactLocation> rdf:type owl:Class ;
                                                   rdfs:comment "The placement of a specific artifact within an arrangement. Links one artifact to one resource path." ;
                                                   rdfs:label "ArtifactLocation" .


###  https://w3id.org/trace/trov/0.1#CompositionFingerprint
<https://w3id.org/trace/trov/0.1#CompositionFingerprint> rdf:type owl:Class ;
                                                         rdfs:comment "A hash computed over the sorted hashes of all artifacts in a composition." ;
                                                         rdfs:label "CompositionFingerprint" .


###  https://w3id.org/trace/trov/0.1#ResearchArtifact
<https://w3id.org/trace/trov/0.1#ResearchArtifact> rdf:type owl:Class ;
                                                   rdfs:comment "A digital object (file, dataset, or bitstream) identified by a content hash." ;
                                                   rdfs:label "ResearchArtifact" .


###  https://w3id.org/trace/trov/0.1#TREAttribute
<https://w3id.org/trace/trov/0.1#TREAttribute> rdf:type owl:Class ;
                                               rdfs:comment "Base class for attributes of a TRS, TRP, or TRO." ;
                                               rdfs:label "TREAttribute" .


###  https://w3id.org/trace/trov/0.1#TROAttribute
<https://w3id.org/trace/trov/0.1#TROAttribute> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/trace/trov/0.1#TREAttribute> ;
                                               rdfs:comment "A transparency claim about a TRO as a whole, warranted by attributes of its constituent TRPs." ;
                                               rdfs:label "TROAttribute" .


###  https://w3id.org/trace/trov/0.1#TRPAttribute
<https://w3id.org/trace/trov/0.1#TRPAttribute> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/trace/trov/0.1#TREAttribute> ;
                                               rdfs:comment "A transparency claim about the conditions under which a specific TRP was conducted." ;
                                               rdfs:label "TRPAttribute" .


###  https://w3id.org/trace/trov/0.1#TRSAttribute
<https://w3id.org/trace/trov/0.1#TRSAttribute> rdf:type owl:Class ;
                                               rdfs:subClassOf <https://w3id.org/trace/trov/0.1#TREAttribute> ;
                                               rdfs:comment "An attribute of a TRS." ;
                                               rdfs:label "TRSAttribute" .


###  https://w3id.org/trace/trov/0.1#TRSCapability
<https://w3id.org/trace/trov/0.1#TRSCapability> rdf:type owl:Class ;
                                                rdfs:subClassOf <https://w3id.org/trace/trov/0.1#TRSAttribute> ;
                                                rdfs:comment "A declared ability of a TRS to enforce a specific transparency condition." ;
                                                rdfs:label "TRSCapability" .


###  https://w3id.org/trace/trov/0.1#TRSPolicy
<https://w3id.org/trace/trov/0.1#TRSPolicy> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/trace/trov/0.1#TRSCapability> ;
                                            rdfs:comment "A TRS-level assertion about a capability. Under redesign — see TROV vocabulary documentation." ;
                                            rdfs:label "TRSPolicy" .


###  https://w3id.org/trace/trov/0.1#TimeStampingAuthority
<https://w3id.org/trace/trov/0.1#TimeStampingAuthority> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://w3id.org/trace/trov/0.1#TrustedResearchElement> ;
                                                        rdfs:comment "An RFC 3161 timestamping authority trusted by a TRS." ;
                                                        rdfs:label "TimeStampingAuthority" .


###  https://w3id.org/trace/trov/0.1#TransparentResearchObject
<https://w3id.org/trace/trov/0.1#TransparentResearchObject> rdf:type owl:Class ;
                                                            rdfs:subClassOf <https://w3id.org/trace/trov/0.1#TrustedResearchElement> ;
                                                            rdfs:comment "A set of research artifacts produced by one or more TRPs and signed by the assembling TRS." ;
                                                            rdfs:label "TransparentResearchObject" .


###  https://w3id.org/trace/trov/0.1#TrustedResearchElement
<https://w3id.org/trace/trov/0.1#TrustedResearchElement> rdf:type owl:Class ;
                                                         rdfs:comment "Common base class for TRSs, TRPs, and TROs." ;
                                                         rdfs:label "TrustedResearchElement" .


###  https://w3id.org/trace/trov/0.1#TrustedResearchPerformance
<https://w3id.org/trace/trov/0.1#TrustedResearchPerformance> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://w3id.org/trace/trov/0.1#TrustedResearchElement> ;
                                                             rdfs:comment "A supervised unit of work conducted by a TRS. The centerpiece of the TRACE conceptual model." ;
                                                             rdfs:label "TrustedResearchPerformance" .


###  https://w3id.org/trace/trov/0.1#TrustedResearchSystem
<https://w3id.org/trace/trov/0.1#TrustedResearchSystem> rdf:type owl:Class ;
                                                        rdfs:subClassOf <https://w3id.org/trace/trov/0.1#TrustedResearchElement> ;
                                                        rdfs:comment "A system that performs TRPs and assembles TROs." ;
                                                        rdfs:label "TrustedResearchSystem" .


