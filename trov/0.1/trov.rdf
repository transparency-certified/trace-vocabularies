    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TimeStampingAuthority -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TimeStampingAuthority">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#TrustedResearchElement"/>
        <rdfs:comment>An RFC 3161 timestamping authority trusted by a TRS.</rdfs:comment>
        <rdfs:label>TimeStampingAuthority</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TransparentResearchObject -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TransparentResearchObject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#TrustedResearchElement"/>
        <rdfs:comment>A set of research artifacts produced by one or more TRPs and signed by the assembling TRS.</rdfs:comment>
        <rdfs:label>TransparentResearchObject</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TrustedResearchElement -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TrustedResearchElement">
        <rdfs:comment>Common base class for TRSs, TRPs, and TROs.</rdfs:comment>
        <rdfs:label>TrustedResearchElement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TrustedResearchPerformance -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TrustedResearchPerformance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#TrustedResearchElement"/>
        <rdfs:comment>A supervised unit of work conducted by a TRS. The centerpiece of the TRACE conceptual model.</rdfs:comment>
        <rdfs:label>TrustedResearchPerformance</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TrustedResearchSystem -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TrustedResearchSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#TrustedResearchElement"/>
        <rdfs:comment>A system that performs TRPs and assembles TROs.</rdfs:comment>
        <rdfs:label>TrustedResearchSystem</rdfs:label>
    </owl:Class>
    


