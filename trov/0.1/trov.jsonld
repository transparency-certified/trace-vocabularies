[ {
  "@id" : "https://w3id.org/trace/trov/0.1#ArtifactArrangement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A named collection of artifact locations. Arrangements are linked to performances as inputs or outputs."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ArtifactArrangement"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#ArtifactCollection",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Base class for collections of one or more artifacts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ArtifactCollection"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#ArtifactComposition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The set of all digital artifacts described by a TRO, identified by a composition fingerprint."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ArtifactComposition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trace/trov/0.1#ArtifactCollection"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#ArtifactLocation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The placement of a specific artifact within an arrangement. Links one artifact to one resource path."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ArtifactLocation"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#CanProvideInternetIsolation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/trace/trov/0.1#TRSCapability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The TRS can isolate computations from network access during a TRP."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CanProvideInternetIsolation"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#CanRecordInternetAccess",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/trace/trov/0.1#TRSCapability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The TRS can record all network accesses made during a TRP."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CanRecordInternetAccess"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#CompositionFingerprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A hash computed over the sorted hashes of all artifacts in a composition."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CompositionFingerprint"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#IncludesAllInputData",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/trace/trov/0.1#TROAttribute"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The TRO composition includes all input data employed in creating the TRO."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "IncludesAllInputData"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#InternetAccessRecording",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/trace/trov/0.1#TRPAttribute"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "All network accesses during the TRP were recorded."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "InternetAccessRecording"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#InternetIsolation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/trace/trov/0.1#TRPAttribute"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The TRP was conducted without network access."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "InternetIsolation"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#ResearchArtifact",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A digital object (file, dataset, or bitstream) identified by a content hash."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ResearchArtifact"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#TREAttribute",
