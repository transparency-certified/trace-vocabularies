    <!-- https://w3id.org/trace/trov/0.1#CanProvideInternetIsolation -->


    <owl:NamedIndividual rdf:about="https://w3id.org/trace/trov/0.1#CanProvideInternetIsolation">
        <rdf:type rdf:resource="https://w3id.org/trace/trov/0.1#TRSCapability"/>
        <rdfs:comment>The TRS can isolate computations from network access during a TRP.</rdfs:comment>
        <rdfs:label>CanProvideInternetIsolation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/trace/trov/0.1#CanRecordInternetAccess -->


    <owl:NamedIndividual rdf:about="https://w3id.org/trace/trov/0.1#CanRecordInternetAccess">
        <rdf:type rdf:resource="https://w3id.org/trace/trov/0.1#TRSCapability"/>
        <rdfs:comment>The TRS can record all network accesses made during a TRP.</rdfs:comment>
        <rdfs:label>CanRecordInternetAccess</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/trace/trov/0.1#IncludesAllInputData -->


    <owl:NamedIndividual rdf:about="https://w3id.org/trace/trov/0.1#IncludesAllInputData">
        <rdf:type rdf:resource="https://w3id.org/trace/trov/0.1#TROAttribute"/>
        <rdfs:comment>The TRO composition includes all input data employed in creating the TRO.</rdfs:comment>
        <rdfs:label>IncludesAllInputData</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/trace/trov/0.1#InternetAccessRecording -->


    <owl:NamedIndividual rdf:about="https://w3id.org/trace/trov/0.1#InternetAccessRecording">
        <rdf:type rdf:resource="https://w3id.org/trace/trov/0.1#TRPAttribute"/>
        <rdfs:comment>All network accesses during the TRP were recorded.</rdfs:comment>
        <rdfs:label>InternetAccessRecording</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/trace/trov/0.1#InternetIsolation -->


    <owl:NamedIndividual rdf:about="https://w3id.org/trace/trov/0.1#InternetIsolation">
        <rdf:type rdf:resource="https://w3id.org/trace/trov/0.1#TRPAttribute"/>
        <rdfs:comment>The TRP was conducted without network access.</rdfs:comment>
        <rdfs:label>InternetIsolation</rdfs:label>
    </owl:NamedIndividual>
    


