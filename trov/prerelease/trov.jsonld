    "@id" : "https://w3id.org/trace/2023/05/trov#TRPAttribute"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The TRP was conducted without network access."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "InternetIsolation"
  } ]
