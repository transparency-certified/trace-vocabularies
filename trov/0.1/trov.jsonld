  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A transparency claim about a TRO as a whole, warranted by attributes of its constituent TRPs."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TROAttribute"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trace/trov/0.1#TREAttribute"
  } ]
}, {
  "@id" : "https://w3id.org/trace/trov/0.1#TRPAttribute",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A transparency claim about the conditions under which a specific TRP was conducted."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "TRPAttribute"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/trace/trov/0.1#TREAttribute"
  } ]
