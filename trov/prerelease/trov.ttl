#################################################################
#    Classes
#################################################################

###  https://w3id.org/trace/2023/05/trov#ArtifactArrangement
:ArtifactArrangement rdf:type owl:Class ;
                     rdfs:comment "A named collection of artifact locations capturing where artifacts were at a point in a workflow." ;
                     rdfs:label "ArtifactArrangement" .


###  https://w3id.org/trace/2023/05/trov#ArtifactComposition
:ArtifactComposition rdf:type owl:Class ;
                     rdfs:comment "The set of all digital artifacts described by a TRO." ;
                     rdfs:label "ArtifactComposition" .


###  https://w3id.org/trace/2023/05/trov#ArtifactLocus
:ArtifactLocus rdf:type owl:Class ;
               rdfs:comment "The location of a specific artifact within an arrangement." ;
               rdfs:label "ArtifactLocus" .


###  https://w3id.org/trace/2023/05/trov#CompositionFingerprint
:CompositionFingerprint rdf:type owl:Class ;
                        rdfs:comment "A hash computed over the sorted hashes of all artifacts in a composition." ;
                        rdfs:label "CompositionFingerprint" .


###  https://w3id.org/trace/2023/05/trov#ResearchArtifact
:ResearchArtifact rdf:type owl:Class ;
                  rdfs:comment "A digital object identified by a content hash." ;
                  rdfs:label "ResearchArtifact" .


###  https://w3id.org/trace/2023/05/trov#TRPAttribute
:TRPAttribute rdf:type owl:Class ;
              rdfs:comment "A transparency attribute of a TRP, warranted by a TRS capability." ;
              rdfs:label "TRPAttribute" .


###  https://w3id.org/trace/2023/05/trov#TRSCapability
:TRSCapability rdf:type owl:Class ;
               rdfs:comment "A capability of a TRS." ;
               rdfs:label "TRSCapability" .


###  https://w3id.org/trace/2023/05/trov#TransparentResearchObject
:TransparentResearchObject rdf:type owl:Class ;
                           rdfs:comment "A set of research artifacts produced by one or more TRPs and signed by the assembling TRS." ;
                           rdfs:label "TransparentResearchObject" .


###  https://w3id.org/trace/2023/05/trov#TrustedResearchPerformance
:TrustedResearchPerformance rdf:type owl:Class ;
                            rdfs:comment "A supervised unit of work conducted by a TRS." ;
                            rdfs:label "TrustedResearchPerformance" .


###  https://w3id.org/trace/2023/05/trov#TrustedResearchSystem
:TrustedResearchSystem rdf:type owl:Class ;
                       rdfs:comment "A system that performs TRPs and assembles TROs." ;
                       rdfs:label "TrustedResearchSystem" .


#################################################################
#    Individuals
#################################################################

###  https://w3id.org/trace/2023/05/trov#CanProvideInternetIsolation
:CanProvideInternetIsolation rdf:type owl:NamedIndividual ,
                                      :TRSCapability ;
                             rdfs:comment "The TRS can isolate computations from network access during a TRP." ;
                             rdfs:label "CanProvideInternetIsolation" .


###  https://w3id.org/trace/2023/05/trov#CanRecordInternetAccess
:CanRecordInternetAccess rdf:type owl:NamedIndividual ,
                                  :TRSCapability ;
                         rdfs:comment "The TRS can record all network accesses made during a TRP." ;
                         rdfs:label "CanRecordInternetAccess" .


###  https://w3id.org/trace/2023/05/trov#InternetAccessRecording
:InternetAccessRecording rdf:type owl:NamedIndividual ,
                                  :TRPAttribute ;
                         rdfs:comment "All network accesses during the TRP were recorded." ;
                         rdfs:label "InternetAccessRecording" .


###  https://w3id.org/trace/2023/05/trov#InternetIsolation
:InternetIsolation rdf:type owl:NamedIndividual ,
                            :TRPAttribute ;
                   rdfs:comment "The TRP was conducted without network access." ;
                   rdfs:label "InternetIsolation" .


