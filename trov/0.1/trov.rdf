    <!-- https://w3id.org/trace/trov/0.1#ArtifactArrangement -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#ArtifactArrangement">
        <rdfs:comment>A named collection of artifact locations. Arrangements are linked to performances as inputs or outputs.</rdfs:comment>
        <rdfs:label>ArtifactArrangement</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#ArtifactCollection -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#ArtifactCollection">
        <rdfs:comment>Base class for collections of one or more artifacts.</rdfs:comment>
        <rdfs:label>ArtifactCollection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#ArtifactComposition -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#ArtifactComposition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#ArtifactCollection"/>
        <rdfs:comment>The set of all digital artifacts described by a TRO, identified by a composition fingerprint.</rdfs:comment>
        <rdfs:label>ArtifactComposition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#ArtifactLocation -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#ArtifactLocation">
        <rdfs:comment>The placement of a specific artifact within an arrangement. Links one artifact to one resource path.</rdfs:comment>
        <rdfs:label>ArtifactLocation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#CompositionFingerprint -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#CompositionFingerprint">
        <rdfs:comment>A hash computed over the sorted hashes of all artifacts in a composition.</rdfs:comment>
        <rdfs:label>CompositionFingerprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#ResearchArtifact -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#ResearchArtifact">
        <rdfs:comment>A digital object (file, dataset, or bitstream) identified by a content hash.</rdfs:comment>
        <rdfs:label>ResearchArtifact</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TREAttribute -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TREAttribute">
        <rdfs:comment>Base class for attributes of a TRS, TRP, or TRO.</rdfs:comment>
        <rdfs:label>TREAttribute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TROAttribute -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TROAttribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#TREAttribute"/>
        <rdfs:comment>A transparency claim about a TRO as a whole, warranted by attributes of its constituent TRPs.</rdfs:comment>
        <rdfs:label>TROAttribute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TRPAttribute -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TRPAttribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#TREAttribute"/>
        <rdfs:comment>A transparency claim about the conditions under which a specific TRP was conducted.</rdfs:comment>
        <rdfs:label>TRPAttribute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TRSAttribute -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TRSAttribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#TREAttribute"/>
        <rdfs:comment>An attribute of a TRS.</rdfs:comment>
        <rdfs:label>TRSAttribute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TRSCapability -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TRSCapability">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#TRSAttribute"/>
        <rdfs:comment>A declared ability of a TRS to enforce a specific transparency condition.</rdfs:comment>
        <rdfs:label>TRSCapability</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/trace/trov/0.1#TRSPolicy -->


    <owl:Class rdf:about="https://w3id.org/trace/trov/0.1#TRSPolicy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/trace/trov/0.1#TRSCapability"/>
        <rdfs:comment>A TRS-level assertion about a capability. Under redesign — see TROV vocabulary documentation.</rdfs:comment>
