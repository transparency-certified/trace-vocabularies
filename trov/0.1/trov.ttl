###  https://w3id.org/trace/trov/0.1#CanProvideInternetIsolation
<https://w3id.org/trace/trov/0.1#CanProvideInternetIsolation> rdf:type owl:NamedIndividual ,
                                                                       <https://w3id.org/trace/trov/0.1#TRSCapability> ;
                                                              rdfs:comment "The TRS can isolate computations from network access during a TRP." ;
                                                              rdfs:label "CanProvideInternetIsolation" .


###  https://w3id.org/trace/trov/0.1#CanRecordInternetAccess
<https://w3id.org/trace/trov/0.1#CanRecordInternetAccess> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/trace/trov/0.1#TRSCapability> ;
                                                          rdfs:comment "The TRS can record all network accesses made during a TRP." ;
                                                          rdfs:label "CanRecordInternetAccess" .


###  https://w3id.org/trace/trov/0.1#IncludesAllInputData
<https://w3id.org/trace/trov/0.1#IncludesAllInputData> rdf:type owl:NamedIndividual ,
                                                                <https://w3id.org/trace/trov/0.1#TROAttribute> ;
                                                       rdfs:comment "The TRO composition includes all input data employed in creating the TRO." ;
                                                       rdfs:label "IncludesAllInputData" .


###  https://w3id.org/trace/trov/0.1#InternetAccessRecording
<https://w3id.org/trace/trov/0.1#InternetAccessRecording> rdf:type owl:NamedIndividual ,
                                                                   <https://w3id.org/trace/trov/0.1#TRPAttribute> ;
                                                          rdfs:comment "All network accesses during the TRP were recorded." ;
                                                          rdfs:label "InternetAccessRecording" .


###  https://w3id.org/trace/trov/0.1#InternetIsolation
<https://w3id.org/trace/trov/0.1#InternetIsolation> rdf:type owl:NamedIndividual ,
                                                             <https://w3id.org/trace/trov/0.1#TRPAttribute> ;
                                                    rdfs:comment "The TRP was conducted without network access." ;
                                                    rdfs:label "InternetIsolation" .


