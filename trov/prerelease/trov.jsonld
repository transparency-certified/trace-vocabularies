    "@value" : "Pre-release (2023/05)"
  } ]
}, {
  "@id" : "https://w3id.org/trace/2023/05/trov#ArtifactArrangement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A named collection of artifact locations capturing where artifacts were at a point in a workflow."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ArtifactArrangement"
  } ]
}, {
  "@id" : "https://w3id.org/trace/2023/05/trov#ArtifactComposition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The set of all digital artifacts described by a TRO."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ArtifactComposition"
  } ]
}, {
  "@id" : "https://w3id.org/trace/2023/05/trov#ArtifactLocus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The location of a specific artifact within an arrangement."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ArtifactLocus"
  } ]
}, {
  "@id" : "https://w3id.org/trace/2023/05/trov#CanProvideInternetIsolation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/trace/2023/05/trov#TRSCapability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The TRS can isolate computations from network access during a TRP."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CanProvideInternetIsolation"
  } ]
}, {
  "@id" : "https://w3id.org/trace/2023/05/trov#CanRecordInternetAccess",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/trace/2023/05/trov#TRSCapability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The TRS can record all network accesses made during a TRP."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "CanRecordInternetAccess"
  } ]
}, {
  "@id" : "https://w3id.org/trace/2023/05/trov#CompositionFingerprint",
